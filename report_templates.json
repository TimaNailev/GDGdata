{
    "Bank Financial Statement": {
        "report_name": "Bank Financial Statement",
        "sections": [
            {
                "type": "summary_metrics",
                "title": "Account Summary",
                "kpis": [
                    "CustomerID",
                    "UnitPrice"
                ],
                "agg": "Average"
            },
            {
                "type": "trend_analysis",
                "title": "Trends Over Time",
                "params": {
                    "trend_var": "OrderDate",
                    "trend_metric": "UnitPrice"
                }
            },
            {
                "type": "details_table",
                "title": "Transaction History",
                "display_cols": [
                    "OrderID",
                    "CustomerID",
                    "ProductName",
                    "Brand",
                    "Raw_Weight",
                    "Country",
                    "OrderDate",
                    "UnitPrice"
                ]
            },
            {
                "type": "ai_insights",
                "title": "AI Insights",
                "params": {
                    "insight_type": "customer_segmentation",
                    "variables": [
                        "CustomerID",
                        "UnitPrice",
                        "Country"
                    ]
                }
            },
            {
                "type": "text_block",
                "title": "Important Notices",
                "content": "Standardized banking notices or user-defined text."
            }
        ]
    },
